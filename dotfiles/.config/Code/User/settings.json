  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#b8c6ea99",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable",
          "variable.language",
          "variable.name",
          "variable.other",
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#9bcbff"
        }
      }
    ]
  }
