{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    //"type": "kitty",
    //"source": "/home/shorin/Pictures/picture.png",
    "width": 25,
    // "height":20,
    "color":{
      "1":"#9bcbff",
      "2":"#9bcbff"
    },
    "padding": {
      "top": 1, // Top padding
      "left": 2, // Left padding
      "right": 2 // Right padding
    },
  },
  "display": {
    "separator": " ", // Separator between keys and values
    "color": {
      //"keys": "#b8c6ea", // Key color module名字的颜色
      "title": "#c0c7d2", // Title color 主机名的颜色
      "output": "#c0c7d2"
    },
  },
  "modules": [
    "break",
    {
      "type": "os", //这是哪个module
      "key": "OS", //module名字的显示
      // "keyColor": "#00ff00",      //module名字颜色
      // "format": "{name} {version}",    //具体内容
      "keyColor": "#9bcbff",
   
    },
    {
      "type": "kernel",
      "key": " ├   KER ",
      "keyColor": "#9bcbff",

    },
    {
      "type": "packages",
      "key": " ├   PAK ",
      "format": "{all}",
      "keyColor": "#9bcbff",
    },
    {
      "type": "command",
      "key": " ├   AGE ",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -f %B /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days",
      "keyColor": "#9bcbff",
    },
    {
      "type": "title",
      "key": " └   USR ",
      "keyColor": "#9bcbff",
    },
    "break",
    "break",
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#bec3fa",
   },
    {
      "type": "de",
      "key": " ├ 󱈹  DES ",
      "keyColor": "#bec3fa",
     //"outputColor": "#bec3fa"
    },
    {
      "type": "shell",
      "key": " ├   SHE ",
      "keyColor": "#bec3fa",
      //"outputColor": "#bec3fa"
    },
    {
      "type": "terminal",
      "key": " ├   TER ",
      "keyColor": "#bec3fa",
      //"outputColor": "#bec3fa"
    },
    {
      "type": "terminalfont",
      "key": " └   TFO ",
      "keyColor": "#bec3fa",
      //"outputColor": "#bec3fa"
    },
    "break",
    "break",
    {
      "type": "host",
      "key": "PC ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "cpu",
      "key": " ├   CPU ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "memory",
      "key": " ├   MEM ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "swap",
      "key": " ├   SWP ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU ",
      "format": "{1} {2}",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "display",
      "key": " ├   MON ",
      "format": "{name} {width}x{height}@{refresh-rate} ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    {
      "type": "disk",
      "key": " └ 󰋊  DIS ",
      "keyColor": "#d8e2ff",
      //"outputColor": "#b8c6ea"
    },
    "break",
    "break",
    "colors"
  ]
}
