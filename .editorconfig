# 编辑器统一格式: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

# Markdown 行尾两个空格是换行, 不能删
[*.md]
trim_trailing_whitespace = false

# 作者的配置和生成的配色: 保持原样, 避免编辑器顺手改掉格式产生无关 diff
[dotfiles/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_size = unset
