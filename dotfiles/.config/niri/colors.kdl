layout{
    focus-ring{
        active-gradient from="#9bcbffcc" to="#bec3facc" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#333a42"
        urgent-color "#ffb4ab"
    }
}
// 内置screencast portal选择器的配色
screen-cast-picker {
    background-color "#192028"
    accent-color "#9bcbff"
    text-color "#dce3ee"
    accent-text-color "#003256"
}
grid-overview {
    minimized-highlight {
        // off
        color "#b8c6eacc"
        urgent-color "#9bcbffcc"
    }
}
